# Copy to /etc/consultwithlawyer/app.env and replace every placeholder.
# Do not commit the populated file.
DATABASE_URL=postgresql://consultwithlawyer:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/consultwithlawyer
APP_PUBLIC_URL=https://consultwithlawyer.in
OWNER_ADMIN_BOOTSTRAP_EMAIL=

# Uploaded file bytes are stored in a persistent host-mounted directory.
OBJECT_STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_DIR=/var/lib/legal-connect/objects

# Clerk production credentials. The publishable key is also needed at web-build time.
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_PRODUCTION_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_PRODUCTION_CLERK_SECRET_KEY

# Optional features remain unavailable unless their production settings are configured.
DEEPSEEK_API_KEY=
DEEPSEEK_INPUT_USD_PER_MILLION_TOKENS=
DEEPSEEK_OUTPUT_USD_PER_MILLION_TOKENS=
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
PUSH_DELIVERY_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TWILIO_CALLS_ENABLED=false
TWILIO_CALL_RECORDING_ENABLED=false
TWILIO_VERIFY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
RAZORPAY_CHECKOUT_VERIFIED_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
