[Unit]
Description=Consult with Lawyer API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=consultwithlawyer
Group=consultwithlawyer
WorkingDirectory=/opt/legal-connect
EnvironmentFile=/etc/consultwithlawyer/app.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
