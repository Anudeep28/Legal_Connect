# Build-time variables for the Vite website; VITE_ values are public in the bundle.
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_PRODUCTION_CLERK_PUBLISHABLE_KEY
# Leave empty when Clerk's DNS records (clerk.<your-domain> CNAME) are set up in
# the Clerk Dashboard. Only set this if you enabled the proxy option in Clerk:
# VITE_CLERK_PROXY_URL=https://consultwithlawyer.in/api/__clerk
VITE_CLERK_PROXY_URL=
