{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:communications": "NODE_ENV=test tsx --test src/lib/__tests__/communications.test.ts",
    "test:ai": "NODE_ENV=test tsx --test src/lib/__tests__/ai-providers.test.ts",
    "seed": "tsx src/lib/seed.ts",
    "grant-admin": "tsx src/lib/grant-admin.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:billing": "NODE_ENV=test RAZORPAY_KEY_ID=rzp_test_fixture RAZORPAY_KEY_SECRET=billing-test-only-secret RAZORPAY_WEBHOOK_SECRET=billing-test-only-webhook RAZORPAY_CHECKOUT_VERIFIED_MODE=test tsx --test src/lib/__tests__/billing.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.87",
    "@clerk/shared": "^4.44.0",
    "@replit/connectors-sdk": "^0.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "twilio": "^6.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "nock": "^15.0.5",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
